{
  "schema_version": "1.0.0",
  "adapter_id": "deepseek-harness",
  "status": "experimental",
  "compatibility": {
    "policy": "explicitly-pinned-developer-preview-version",
    "breaking_changes_expected": true,
    "target_release": "dsh-v0.1.5-rc.1",
    "python_package": "deepseek-harness-sdk==0.1.5rc1",
    "runtime_package": "deepseek-harness-runtime-bin==0.1.5rc1",
    "sdk_call_contract": "DeepSeekHarness.run(input, session_id=...)",
    "profile": "sdk-minimal",
    "readonly_patch_sha256": "4c3c4a207cab4ac1dea8bd625500ed763a556dae9446be0fa559719209f2427b",
    "session_recovery": "checkpoint-facts-new-process-session"
  },
  "maps": {
    "agent_profile": "agent-provider-and-preset",
    "registry_tools": "tool-plugins",
    "registry_skills": "skill-plugins",
    "loop_spec": "loop-and-scheduler-plugins",
    "trajectory": "append-only-session-events",
    "human_gate": "unsupported-in-readonly-mvp"
  },
  "required_capabilities": [
    "append_only_events",
    "sandbox_network_allowlist"
  ],
  "conditional_capabilities": {
    "human_gate": "unsupported-and-rejected",
    "scheduled_loops": "unsupported-and-rejected"
  },
  "readonly_guards": [
    "lockfile-tool-only",
    "side-effects-read-or-none",
    "approval-false",
    "idempotent-true",
    "agent-external-write-deny",
    "no-model-facing-tools",
    "model-facts-equal-trusted-tool-facts",
    "tool-binding-input-output-json-schema",
    "tool-binding-reviewed-implementation-digest",
    "per-agent-and-node-budget-accounting",
    "ed25519-binding-manifest-signature",
    "ed25519-registry-lock-signature",
    "trusted-publisher-key-status",
    "root-signed-trust-store",
    "signed-complete-package-manifest",
    "reject-missing-modified-or-injected-package-files",
    "pluggable-signing-provider",
    "pkcs11-ed25519-signing-provider",
    "signed-runtime-events",
    "signed-runtime-checkpoints",
    "sqlite-transactional-event-store",
    "runtime-leases-and-terminal-retention",
    "dev-team-regulated-complexity-profiles",
    "runtime-profile-preflight",
    "active-runtime-signing-key-enforcement"
  ],
  "host_binding_manifest": "readonly-tool-bindings.json",
  "host_binding_signature": "readonly-tool-bindings.sig.json",
  "trust_store": "../../trust/trusted-publishers.json",
  "trust_store_signature": "../../trust/trusted-publishers.sig.json",
  "trust_root_public_key": "../../trust/root-public-key.json",
  "unsupported_behavior": "fail-before-execution-never-silently-drop"
}
