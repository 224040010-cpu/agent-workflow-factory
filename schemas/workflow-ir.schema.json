{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow-factory.local/schemas/workflow-ir.schema.json",
  "title": "Workflow IR",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "workflow.skill-registry/v1alpha1" },
    "kind": { "const": "Workflow" },
    "metadata": {
      "type": "object",
      "required": ["id", "version", "source_digest", "compiler_version"]
    },
    "spec": {
      "type": "object",
      "required": ["intent", "entry", "terminals", "participants", "nodes", "edges", "required_skills"],
      "properties": {
        "entry": { "type": "string" },
        "terminals": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "name", "source_ref", "completion_evidence"]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from", "to"]
          }
        }
      }
    }
  }
}
