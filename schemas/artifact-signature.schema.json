{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow-factory.local/schemas/artifact-signature.schema.json",
  "title": "Agent Workflow Factory Detached Artifact Signature",
  "type": "object",
  "additionalProperties": false,
  "required": ["statement", "signature"],
  "properties": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "subject", "publisher", "key_id", "algorithm",
        "canonicalization", "issued_at"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "digest", "media_type"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "media_type": {"const": "application/json"}
          }
        },
        "publisher": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "algorithm": {"const": "Ed25519"},
        "canonicalization": {"const": "AWF-CANONICAL-JSON-v1"},
        "issued_at": {"type": "string", "format": "date-time"}
      }
    },
    "signature": {"type": "string", "minLength": 1}
  }
}
